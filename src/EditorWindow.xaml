<local:GlassWindow x:Class="Scr.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scr"
        Title="Scr" Width="1120" Height="720" MinWidth="820" MinHeight="560"
        Icon="Assets/scr.ico" WindowStartupLocation="CenterScreen">
  <Grid x:Name="Root" Background="{DynamicResource B.WindowTint}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <!-- Title bar (Windows draws its own buttons on the right) -->
    <DockPanel Margin="14,0,150,0" LastChildFill="False">
      <Image Source="Assets/scr.ico" Width="18" Height="18" VerticalAlignment="Center"/>
      <TextBlock Text="Scr" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,1" VerticalAlignment="Center"/>
      <TextBlock x:Name="SizeText" Foreground="{DynamicResource B.Muted}" FontSize="12" Margin="12,0,0,1" VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" ToolTip="Settings" Click="OnSettings"
              WindowChrome.IsHitTestVisibleInChrome="True" Height="32" Width="32">
        <Viewbox Width="18" Height="18">
          <Path Data="{StaticResource I.Settings}" Style="{StaticResource Icon}"/>
        </Viewbox>
      </Button>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="316"/>
      </Grid.ColumnDefinitions>

      <!-- The one main surface: the live preview -->
      <Border x:Name="Sheet" Margin="10,0,2,10" CornerRadius="8" Background="{DynamicResource B.Sheet}"
              BorderBrush="{DynamicResource B.SheetEdge}" BorderThickness="1">
        <Grid>
          <Grid Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Checker}">
            <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Grid>
          <Border x:Name="Toast" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                  Margin="0,0,0,16" Background="{DynamicResource B.Ink}" CornerRadius="6" Padding="14,7,14,8">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource B.InkInverse}" FontSize="13"/>
          </Border>
        </Grid>
      </Border>

      <!-- Controls -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,10,0" Focusable="False">
          <StackPanel Margin="0,0,6,8">
            <TextBlock Style="{StaticResource SectionLabel}" Text="FRAME" Margin="0,4,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Margin="0,0,0,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=PadSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Backdrop" FontSize="13"/>
                </DockPanel>
                <Slider x:Name="PadSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="200" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,0,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=ShadowSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Shadow" FontSize="13"/>
                </DockPanel>
                <Slider x:Name="ShadowSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=OuterSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Corners" FontSize="13"/>
                </DockPanel>
                <Slider x:Name="OuterSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="60" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=InsetSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Inset" FontSize="13" ToolTip="Room around the screenshot inside its frame, in the screenshot's own edge colour"/>
                </DockPanel>
                <Slider x:Name="InsetSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0"/>
              </StackPanel>

              <StackPanel Grid.Row="2" x:Name="InnerBox" Margin="0,0,0,4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=InnerSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Inner corners" FontSize="13"/>
                </DockPanel>
                <Slider x:Name="InnerSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="60" Margin="0,4,0,0"/>
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="2" x:Name="InnerNote" Style="{StaticResource Note}" FontSize="12"
                         VerticalAlignment="Center" Text="Inner corners round the screenshot inside an inset."/>
            </Grid>

            <TextBlock Style="{StaticResource SectionLabel}" Text="BACKDROP"/>
            <Border Style="{StaticResource SegTrack}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="KindSolid" Content="Solid" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="KindGradient" Content="Gradient" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="KindPicture" Content="Picture" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>

            <StackPanel x:Name="GradientPanel" Margin="0,12,0,0">
              <UniformGrid x:Name="GradientGrid" Columns="6" Margin="0,0,-6,0"/>
              <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" x:Name="ShuffleBtn" Style="{StaticResource IconBtn}" ToolTip="Shuffle" Margin="4,0,0,0">
                  <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.Shuffle}" Style="{StaticResource Icon}"/></Viewbox>
                </Button>
                <Button DockPanel.Dock="Right" x:Name="SwapBtn" Style="{StaticResource IconBtn}" ToolTip="Swap colours" Margin="6,0,0,0">
                  <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.Swap}" Style="{StaticResource Icon}"/></Viewbox>
                </Button>
                <Border Style="{StaticResource SegTrack}">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="ShapeMesh" Content="Mesh" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="ShapeLinear" Content="Linear" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="ShapeRadial" Content="Radial" Style="{StaticResource Seg}"/>
                  </UniformGrid>
                </Border>
              </DockPanel>
            </StackPanel>

            <StackPanel x:Name="SolidPanel" Margin="0,12,0,0">
              <UniformGrid x:Name="SolidGrid" Columns="6" Margin="0,0,-6,0"/>
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Colour" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="HexBox" Style="{StaticResource Field}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                         ToolTip="A colour code like #5558C0, then Enter"/>
              </DockPanel>
            </StackPanel>

            <StackPanel x:Name="PicturePanel" Margin="0,12,0,0">
              <Border Style="{StaticResource SegTrack}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="PicCapture" Content="Screenshot, blurred" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="PicFile" Content="My picture" Style="{StaticResource Seg}"/>
                </UniformGrid>
              </Border>
              <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" x:Name="ChooseBtn" Content="Choose…" Style="{StaticResource Btn}"/>
                <CheckBox x:Name="PicBlur" Style="{StaticResource Switch}" VerticalAlignment="Center">
                  <TextBlock Text="Blur it" FontSize="13"/>
                </CheckBox>
              </DockPanel>
              <TextBlock x:Name="PicName" Style="{StaticResource Note}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionLabel}" Text="SIZE"/>
            <Border Style="{StaticResource SegTrack}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="RatioAuto" Content="Fit" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="RatioWide" Content="16:9" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="RatioClassic" Content="4:3" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="RatioSquare" Content="1:1" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource B.Hairline}" Padding="14,12,16,12">
          <DockPanel LastChildFill="False">
            <Button x:Name="PlainBtn" Content="Plain" Style="{StaticResource GhostBtn}" Padding="12,0"
                    ToolTip="Just the screenshot, with no frame"/>
            <Button DockPanel.Dock="Right" x:Name="CopyBtn" Content="Copy" Style="{StaticResource PrimaryBtn}" MinWidth="92"
                    Margin="8,0,0,0" ToolTip="Copy the framed picture to the clipboard (Ctrl+C or Enter)"/>
            <Button DockPanel.Dock="Right" x:Name="SaveBtn" Content="Save…" Style="{StaticResource Btn}" ToolTip="Save as a PNG picture (Ctrl+S)"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</local:GlassWindow>
