<local:GlassWindow x:Class="Scr.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scr"
        Title="Scr" Width="1120" Height="720" MinWidth="820" MinHeight="560"
        Icon="Assets/scr.ico" WindowStartupLocation="CenterScreen">
  <Grid x:Name="Root" Background="{DynamicResource B.WindowTint}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <!-- Title bar, 44 px like Kalendar's; the caption buttons on the right are drawn by GlassWindow.
         Left, over the panel: the icon, the name and the picture's size. Right, over the editor surface: the tabs,
         which sit at the bar's bottom edge and join the surface, starting where it starts. -->
    <Grid x:Name="TitleBar" Panel.ZIndex="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="316"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
        <Image Source="Assets/scr.ico" Width="18" Height="18" VerticalAlignment="Center"/>
        <TextBlock Text="Scr" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,1" VerticalAlignment="Center"/>
        <TextBlock x:Name="SizeText" Foreground="{DynamicResource B.Muted}" FontSize="12" Margin="12,0,0,1" VerticalAlignment="Center"/>
      </StackPanel>
      <DockPanel Grid.Column="1" LastChildFill="True" Margin="2,0,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" ToolTip="Settings" Click="OnSettings"
                WindowChrome.IsHitTestVisibleInChrome="True" Height="32" Width="34" VerticalAlignment="Center">
          <Viewbox Width="17" Height="17">
            <Path Data="{StaticResource I.Settings}" Style="{StaticResource Icon}"/>
          </Viewbox>
        </Button>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
          <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Bottom"/>
          <!-- Lined up with the tab labels (tabs are 35 tall at the bottom of the 44 px bar) -->
          <Button x:Name="NewCaptureBtn" Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="4,0,0,2" VerticalAlignment="Bottom"
                  ToolTip="New capture, from the clipboard or a picture" WindowChrome.IsHitTestVisibleInChrome="True">
            <Viewbox Width="15" Height="15">
              <Path Data="{StaticResource I.Plus}" Style="{StaticResource Icon}"/>
            </Viewbox>
          </Button>
        </StackPanel>
      </DockPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="316"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <!-- The one main surface: the live preview -->
      <!-- The surface's fill and bright edge are drawn by SheetShape (EditorWindow), together with the chosen tab, as one shape -->
      <Border x:Name="Sheet" Grid.Column="1" local:SheetShadow.Enabled="True" Margin="2,0,10,10" CornerRadius="8" Background="Transparent">
        <Grid>
          <Grid Margin="32,62,32,32" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Checker}">
            <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <!-- The area being marked while you drag, and the crop shown while the Crop tool is on -->
            <Canvas IsHitTestVisible="False">
              <Path x:Name="CropShade" Fill="#80000000" Visibility="Collapsed"/>
              <Rectangle x:Name="RedactBox" Visibility="Collapsed" Stroke="White" StrokeThickness="1.5"
                         StrokeDashArray="4 3" Fill="#33000000">
                <Rectangle.Effect>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6"/>
                </Rectangle.Effect>
              </Rectangle>
            </Canvas>
          </Grid>
          <!-- Shown when the editor is open with nothing in it (Open the editor from the tray) -->
          <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Nothing to frame yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock Style="{StaticResource Note}" Margin="0,6,0,18" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="Take a capture, paste a picture or open one."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="EmptyCaptureBtn" Content="New capture" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0"/>
              <Button x:Name="EmptyPasteBtn" Content="Paste" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
              <Button x:Name="EmptyOpenBtn" Content="Open a picture…" Style="{StaticResource Btn}"/>
            </StackPanel>
          </StackPanel>

          <!-- Tools: nothing is on until you click one; only the active tool's options show -->
          <Border x:Name="ToolBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="4" CornerRadius="8"
                  Background="{DynamicResource B.Menu}" BorderBrush="{DynamicResource B.MenuEdge}" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="ToolRedact" Style="{StaticResource ToolBtn}" ToolTip="Redact: hide names, numbers or faces (R)">
                <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.EyeOff}" Style="{StaticResource Icon}"/></Viewbox>
              </ToggleButton>
              <ToggleButton x:Name="ToolCrop" Style="{StaticResource ToolBtn}" ToolTip="Crop (C)">
                <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.Crop}" Style="{StaticResource Icon}"/></Viewbox>
              </ToggleButton>
              <ToggleButton x:Name="ToolHighlight" Style="{StaticResource ToolBtn}" ToolTip="Highlight (H)">
                <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.Highlight}" Style="{StaticResource Icon}"/></Viewbox>
              </ToggleButton>
              <ToggleButton x:Name="ToolSpotlight" Style="{StaticResource ToolBtn}" ToolTip="Spotlight: dim everything else (S)">
                <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.Spotlight}" Style="{StaticResource Icon}"/></Viewbox>
              </ToggleButton>

              <StackPanel x:Name="ToolOptions" Orientation="Horizontal" Visibility="Collapsed">
                <Border Width="1" Margin="6,6" Background="{DynamicResource B.Hairline}"/>
                <TextBlock x:Name="ToolHint" FontSize="12.5" Foreground="{DynamicResource B.Muted}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <Border x:Name="RedactOptions" Style="{StaticResource SegTrack}" Width="150">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="RedactPixelate" Content="Pixelate" Style="{StaticResource Seg}" Height="26"/>
                    <RadioButton x:Name="RedactBlur" Content="Blur" Style="{StaticResource Seg}" Height="26"/>
                  </UniformGrid>
                </Border>
                <Button x:Name="CropResetBtn" Content="Reset" Style="{StaticResource GhostBtn}" Height="30" Padding="10,0"
                        ToolTip="Back to the whole capture"/>
                <StackPanel x:Name="HighlightOptions" Orientation="Horizontal">
                  <Border Style="{StaticResource SegTrack}" Width="130">
                    <UniformGrid Rows="1">
                      <RadioButton x:Name="HighlightBox" Content="Box" Style="{StaticResource Seg}" Height="26"/>
                      <RadioButton x:Name="HighlightMarker" Content="Marker" Style="{StaticResource Seg}" Height="26"/>
                    </UniformGrid>
                  </Border>
                  <StackPanel x:Name="ColorDots" Orientation="Horizontal" Margin="8,0,2,0"/>
                </StackPanel>
              </StackPanel>

              <Border Width="1" Margin="6,6" Background="{DynamicResource B.Hairline}"/>
              <Button x:Name="UndoBtn" Style="{StaticResource IconBtn}" Height="30" Width="32" ToolTip="Undo (Ctrl+Z)">
                <Viewbox Width="17" Height="17"><Path Data="{StaticResource I.Undo}" Style="{StaticResource Icon}"/></Viewbox>
              </Button>
              <Button x:Name="RedoBtn" Style="{StaticResource IconBtn}" Height="30" Width="32" ToolTip="Redo (Ctrl+Y)">
                <Viewbox Width="17" Height="17"><Path Data="{StaticResource I.Redo}" Style="{StaticResource Icon}"/></Viewbox>
              </Button>
            </StackPanel>
          </Border>
          <Border x:Name="Toast" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                  Margin="0,0,0,16" Background="{DynamicResource B.Ink}" CornerRadius="6" Padding="14,7,14,8">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource B.InkInverse}" FontSize="13"/>
          </Border>
        </Grid>
      </Border>

      <!-- Controls: the panel on the left, like Kalendar's and Notat's sidebar -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" Padding="16,0,8,0" Focusable="False">
          <StackPanel Margin="0,0,6,20">
            <TextBlock Style="{StaticResource SectionLabel}" Text="FRAME" Margin="0,8,0,14"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Margin="0,0,0,18">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=PadSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Backdrop" FontSize="13" ToolTip="Room around the screenshot"/>
                </DockPanel>
                <Slider x:Name="PadSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="200" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,0,18">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=OuterSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Corners" FontSize="13"/>
                </DockPanel>
                <Slider x:Name="OuterSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="60" Margin="0,4,0,0"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=InsetSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Inset" FontSize="13" ToolTip="Room around the screenshot inside its frame, in the screenshot's own edge colour"/>
                </DockPanel>
                <Slider x:Name="InsetSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" x:Name="InnerBox" Margin="0,0,0,18">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=InnerSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Inner corners" FontSize="13" ToolTip="Rounds the screenshot inside an inset"/>
                </DockPanel>
                <Slider x:Name="InnerSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="60" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>

            <DockPanel x:Name="InsetLookPanel" Margin="0,2,0,18">
              <TextBlock Text="Inset" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource B.Muted}"/>
              <Border Style="{StaticResource SegTrack}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="InsetAuto" Content="Auto" Style="{StaticResource Seg}" Height="26"
                               ToolTip="Glass for colourful edges, the edge colour for a plain one"/>
                  <RadioButton x:Name="InsetGlass" Content="Glass" Style="{StaticResource Seg}" Height="26"
                               ToolTip="See-through, like frosted glass over the backdrop"/>
                  <RadioButton x:Name="InsetEdge" Content="Edge" Style="{StaticResource Seg}" Height="26"
                               ToolTip="Filled with the screenshot's own edge colour"/>
                </UniformGrid>
              </Border>
            </DockPanel>

            <StackPanel x:Name="FrostBox" Margin="0,0,0,18">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                           Text="{Binding Value, ElementName=FrostSlider, StringFormat={}{0:0}}"/>
                <TextBlock Text="Frost" FontSize="13" ToolTip="From clear glass to milky, blurred frosted glass"/>
              </DockPanel>
              <Slider x:Name="FrostSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource B.Hairline}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource SectionLabel}" Text="SHADOW" Margin="0,18,0,14"/>
            <Grid x:Name="ShadowBox">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,0,18">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=ShadowSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Strength" FontSize="13" ToolTip="How dark the shadow is. 0 is no shadow"/>
                </DockPanel>
                <Slider x:Name="ShadowSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,0,18">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource B.Muted}" FontSize="12.5"
                             Text="{Binding Value, ElementName=ShadowSizeSlider, StringFormat={}{0:0}}"/>
                  <TextBlock Text="Size" FontSize="13" ToolTip="How far the shadow reaches and how soft it is"/>
                </DockPanel>
                <Slider x:Name="ShadowSizeSlider" Style="{StaticResource FrameSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource B.Hairline}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource SectionLabel}" Text="BACKDROP" Margin="0,18,0,14"/>
            <Border Style="{StaticResource SegTrack}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="KindSolid" Content="Solid" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="KindGradient" Content="Gradient" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="KindPicture" Content="Picture" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>

            <StackPanel x:Name="GradientPanel" Margin="0,16,0,0">
              <UniformGrid x:Name="GradientGrid" Columns="6" Margin="0,0,-6,0"/>
              <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" x:Name="ShuffleBtn" Style="{StaticResource IconBtn}" ToolTip="Shuffle" Margin="4,0,0,0">
                  <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.Shuffle}" Style="{StaticResource Icon}"/></Viewbox>
                </Button>
                <Button DockPanel.Dock="Right" x:Name="SwapBtn" Style="{StaticResource IconBtn}" ToolTip="Swap colours" Margin="6,0,0,0">
                  <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.Swap}" Style="{StaticResource Icon}"/></Viewbox>
                </Button>
                <Border Style="{StaticResource SegTrack}">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="ShapeMesh" Content="Mesh" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="ShapeLinear" Content="Linear" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="ShapeRadial" Content="Radial" Style="{StaticResource Seg}"/>
                  </UniformGrid>
                </Border>
              </DockPanel>
            </StackPanel>

            <StackPanel x:Name="SolidPanel" Margin="0,16,0,0">
              <UniformGrid x:Name="SolidGrid" Columns="6" Margin="0,0,-6,0"/>
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Colour" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="HexBox" Style="{StaticResource Field}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                         ToolTip="A colour code like #5558C0, then Enter"/>
              </DockPanel>
            </StackPanel>

            <StackPanel x:Name="PicturePanel" Margin="0,16,0,0">
              <Border Style="{StaticResource SegTrack}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="PicCapture" Content="Screenshot, blurred" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="PicFile" Content="My picture" Style="{StaticResource Seg}"/>
                </UniformGrid>
              </Border>
              <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" x:Name="ChooseBtn" Content="Choose…" Style="{StaticResource Btn}"/>
                <CheckBox x:Name="PicBlur" Style="{StaticResource Switch}" VerticalAlignment="Center">
                  <TextBlock Text="Blur it" FontSize="13"/>
                </CheckBox>
              </DockPanel>
              <TextBlock x:Name="PicName" Style="{StaticResource Note}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource B.Hairline}" Margin="0,22,0,0"/>
            <TextBlock Style="{StaticResource SectionLabel}" Text="SIZE" Margin="0,18,0,14"/>
            <Border Style="{StaticResource SegTrack}">
              <UniformGrid Rows="1">
                <RadioButton x:Name="RatioAuto" Content="Fit" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="RatioWide" Content="16:9" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="RatioClassic" Content="4:3" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="RatioSquare" Content="1:1" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource B.Hairline}" Padding="16,12,14,12">
          <DockPanel LastChildFill="False">
            <Button x:Name="PlainBtn" Content="Plain" Style="{StaticResource Btn}" Padding="12,0" MinWidth="64"
                    ToolTip="Just the screenshot, with no frame"/>
            <Button DockPanel.Dock="Right" x:Name="CopyBtn" Content="Copy" Style="{StaticResource PrimaryBtn}" MinWidth="84"
                    Margin="6,0,0,0" ToolTip="Copy the framed picture to the clipboard (Ctrl+C or Enter)"/>
            <Button DockPanel.Dock="Right" x:Name="SaveBtn" Content="Save…" Style="{StaticResource Btn}" Padding="12,0" ToolTip="Save as a PNG picture (Ctrl+S)"/>
            <Button DockPanel.Dock="Right" x:Name="HistoryBtn" Style="{StaticResource Btn}" Width="36" Padding="0" Margin="6,0,6,0"
                    ToolTip="Reopen a closed capture">
              <Viewbox Width="18" Height="18"><Path Data="{StaticResource I.History}" Style="{StaticResource Icon}"/></Viewbox>
            </Button>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</local:GlassWindow>
