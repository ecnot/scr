<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Scr</AssemblyName>
    <RootNamespace>Scr</RootNamespace>
    <Version>0.2.0</Version>
    <Product>Scr</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\scr.ico</ApplicationIcon>

    <!-- Small and quick: one language, workstation GC without the background thread.
         (InvariantGlobalization can't be used: WPF bindings need a real culture.) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\scr.ico" />
    <None Include="Assets\scr.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
